.DEFAULT_GOAL := help
.PHONY: help generate generate-check api-gen api-lint proto-gen proto-lint build go-build web-install web-build web-embed test go-test web-test web-e2e lint go-lint golangci web-lint licenses notices run web-dev docker release release-dry-run clean

MODULE    := github.com/joinsider/pulsequorum
GO_PKGS   := ./cmd/... ./internal/... ./build/...
BIN       := bin/pulsequorum
WEB_DIST  := web/dist/pulsequorum-web/browser
EMBED_DIR := internal/webui/dist
# Generated code only (internal/api/internal/stubgen is hand-written and excluded).
GENERATED_PATHS := internal/api/gen internal/api/unimplemented.go internal/pb web/src/app/api internal/store/sqlite/statedb internal/store/sqlite/metricsdb

VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
COMMIT  ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)
DATE    ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS := -s -w \
	-X $(MODULE)/internal/version.Version=$(VERSION) \
	-X $(MODULE)/internal/version.Commit=$(COMMIT) \
	-X $(MODULE)/internal/version.Date=$(DATE)

help: ## Show available targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-14s %s\n", $$1, $$2}'

generate: api-gen proto-gen sqlc-gen ## Regenerate all generated code (OpenAPI, protobuf, sqlc)

generate-check: generate ## Fail if generated code is stale (regenerates, then checks for diffs)
	git diff --exit-code -- $(GENERATED_PATHS)
	@untracked="$$(git ls-files --others --exclude-standard -- $(GENERATED_PATHS))"; if [ -n "$$untracked" ]; then echo "generated code has untracked files:"; echo "$$untracked"; exit 1; fi

api-gen: web/node_modules ## Generate Go server and Angular client from the OpenAPI contract
	go tool -modfile=tools/go.mod oapi-codegen -config api/oapi-codegen.yaml api/openapi.yaml
	go run ./internal/api/internal/stubgen internal/api/gen/api.gen.go internal/api/unimplemented.go
	cd web && npx orval --config orval.config.ts

sqlc-gen: ## Generate typed SQL queries for internal/store/sqlite
	go tool -modfile=tools/go.mod sqlc generate

proto-gen: ## Generate Go code from proto/ with buf
	go tool -modfile=tools/go.mod buf generate

proto-lint: ## Lint protobuf definitions
	go tool -modfile=tools/go.mod buf lint

api-lint: web/node_modules ## Lint the OpenAPI contract
	cd web && npx redocly lint ../api/openapi.yaml --config ../api/redocly.yaml

build: web-embed go-build ## Build the frontend and the binary with the embedded SPA

go-build: ## Build only the Go binary (embeds whatever is in internal/webui/dist)
	CGO_ENABLED=0 go build -trimpath -ldflags "$(LDFLAGS)" -o $(BIN) ./cmd/pulsequorum

web/node_modules: web/package.json web/package-lock.json
	cd web && npm ci
	@touch web/node_modules

web-install: web/node_modules ## Install frontend dependencies

web-build: web/node_modules ## Build the Angular SPA
	cd web && npx ng build

web-embed: web-build ## Copy the SPA build into the Go embed directory
	rsync -a --delete --exclude .gitkeep $(WEB_DIST)/ $(EMBED_DIR)/

test: go-test web-test ## Run all tests

go-test: ## Run Go tests with race detector
	go test -race -cover $(GO_PKGS)

web-test: web/node_modules ## Run frontend unit tests
	cd web && npx ng test --watch=false

web-e2e: build web/node_modules ## Run Playwright E2E smoke tests against the built binary (runs make build first)
	cd web && npx playwright test

lint: go-lint golangci web-lint api-lint proto-lint ## Run all linters

go-lint: ## go vet and gofmt check
	go vet $(GO_PKGS)
	@out="$$(gofmt -l cmd internal build)"; if [ -n "$$out" ]; then echo "gofmt needed:"; echo "$$out"; exit 1; fi

golangci: ## Run golangci-lint v2 (standard + errorlint, gosec, revive, ...; config in .golangci.yml)
	go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0 run ./...

web-lint: web/node_modules ## Prettier check
	cd web && npx prettier --check src

# Dual-licensed EPL-2.0 OR EDL-1.0; used under EDL-1.0 (BSD-3-Clause), see ADR 0014.
LICENSE_EXCEPTIONS := --ignore github.com/eclipse/paho.golang
# Python-2.0 (PSF, permissive); only used by transloco's build-time config loader
# (transloco-utils -> cosmiconfig -> js-yaml), not part of the browser bundle.
NPM_LICENSE_EXCEPTIONS := --excludePackages "argparse@2.0.1"

licenses: web/node_modules ## Check Go and npm production licenses against the ADR 0010 allow-list
	go run github.com/google/go-licenses/v2@v2.0.1 check ./cmd/pulsequorum --ignore $(MODULE) $(LICENSE_EXCEPTIONS) --allowed_licenses=MIT,BSD-2-Clause,BSD-3-Clause,Apache-2.0,ISC,MPL-2.0,0BSD,Unlicense
	cd web && npx --yes license-checker-rseidelsohn@4.4.2 --production --excludePrivatePackages $(NPM_LICENSE_EXCEPTIONS) --onlyAllow "MIT;BSD-2-Clause;BSD-3-Clause;Apache-2.0;ISC;MPL-2.0;0BSD;Unlicense"

notices: web/node_modules ## Generate THIRD_PARTY_NOTICES.md (Go and npm production dependencies)
	@{ \
	  printf '%s\n\n' '# Third-party notices'; \
	  printf '%s\n\n' 'Generated by `make notices`. Lists the Go modules of `./cmd/pulsequorum` and the npm production dependencies of the web UI.'; \
	  go run github.com/google/go-licenses/v2@v2.0.1 report ./cmd/pulsequorum --ignore $(MODULE) $(LICENSE_EXCEPTIONS) --template build/notices-go.tmpl; \
	  printf '\n%s\n\n' '- github.com/eclipse/paho.golang: Eclipse Distribution License 1.0 (BSD-3-Clause), chosen from EPL-2.0 OR EDL-1.0 (ADR 0014)'; \
	  printf '\n%s\n\n' '## npm production dependencies'; \
	  (cd web && npx --yes license-checker-rseidelsohn@4.4.2 --production --excludePrivatePackages --markdown); \
	} > THIRD_PARTY_NOTICES.md
	@echo "wrote THIRD_PARTY_NOTICES.md"

run: build ## Run a local single voter on :8080
	mkdir -p .data
	DATA_DIR=.data NODE_NAME=dev LOG_FORMAT=text $(BIN)

web-dev: web/node_modules ## Angular dev server on :4200 proxying the API to :8080
	cd web && npx ng serve

docker: ## Build the container image
	docker build --build-arg VERSION=$(VERSION) --build-arg COMMIT=$(COMMIT) --build-arg DATE=$(DATE) -t pulsequorum:dev .

BUMP ?= patch
release: ## Cut a release: signed tag on master, editable changelog (BUMP=patch|minor|major, optional VERSION=x.y.z)
	go run ./build/release -bump=$(BUMP) $(if $(VERSION),-version=$(VERSION))

release-dry-run: ## Show the next version and changelog without creating anything
	go run ./build/release -bump=$(BUMP) $(if $(VERSION),-version=$(VERSION)) -dry-run

clean: ## Remove build output
	rm -rf bin web/dist THIRD_PARTY_NOTICES.md
	find $(EMBED_DIR) -mindepth 1 ! -name .gitkeep -delete
