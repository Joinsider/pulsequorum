# syntax=docker/dockerfile:1

# Local build of the web image (ADR 0036 6B), see make docker-web. Unlike
# Dockerfile.web.release, GoReleaser does not build the artifacts here, so this file
# builds the SPA and pulsequorum-webconfig itself. The final stage matches
# Dockerfile.web.release, except that it has no THIRD_PARTY_NOTICES.md (generated
# by make notices, which needs the network).

# --- Frontend ---------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:26-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
RUN npm run build

# --- Config writer ----------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
WORKDIR /src
COPY go.* ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/

ARG TARGETOS TARGETARCH
ARG VERSION=dev COMMIT=unknown DATE=unknown
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags "-s -w \
      -X github.com/joinsider/pulsequorum/internal/version.Version=${VERSION} \
      -X github.com/joinsider/pulsequorum/internal/version.Commit=${COMMIT} \
      -X github.com/joinsider/pulsequorum/internal/version.Date=${DATE}" \
    -o /out/pulsequorum-webconfig ./cmd/pulsequorum-webconfig

# --- Runtime ----------------------------------------------------------------
# Base image: official nginx (Docker Official Image), stable line, Alpine. Pinned by
# digest; Dependabot updates it (ADR 0036 6B, addendum of 2026-11-28). It runs as
# UID 101 (USER below), listens on 8080 and keeps pid and temp files under /tmp
# (deploy/web/nginx.conf), as nginx-unprivileged did before.
FROM nginx:1.30.8-alpine3.24@sha256:8eb04fe3b385090e9aa02961f77398ad09b6bf33ab07f6669a5bb7acce22c0d3
# Alpine security fixes between upstream rebuilds. nginx itself comes from nginx.org
# and must not be swapped for the Alpine build; the version check fails the build if
# it is. The upstream entrypoint helpers and the default server are unused (our
# nginx.conf replaces the main configuration) and would only log "can not modify"
# as UID 101, so they are removed; our own script is copied in below.
RUN before="$(nginx -v 2>&1)" \
 && apk upgrade --no-cache \
 && after="$(nginx -v 2>&1)" \
 && test "$before" = "$after" \
 && find /docker-entrypoint.d -mindepth 1 -delete \
 && rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /out/pulsequorum-webconfig /usr/local/bin/pulsequorum-webconfig
COPY --from=web /src/web/dist/pulsequorum-web/browser/ /usr/share/nginx/html/
COPY deploy/web/nginx.conf /etc/nginx/nginx.conf
COPY --chmod=0755 deploy/web/10-pulsequorum-webconfig.sh /docker-entrypoint.d/10-pulsequorum-webconfig.sh
COPY LICENSE /licenses/
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
