# syntax=docker/dockerfile:1

# Local build of the slim probe image (ADR 0043). Unlike Dockerfile there is no
# frontend stage: the probe role serves no UI and links no web code.

# --- Backend ----------------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
WORKDIR /src
COPY go.* ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/

ARG TARGETOS TARGETARCH
ARG VERSION=dev COMMIT=unknown DATE=unknown
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags "-s -w \
      -X github.com/joinsider/pulsequorum/internal/version.Version=${VERSION} \
      -X github.com/joinsider/pulsequorum/internal/version.Commit=${COMMIT} \
      -X github.com/joinsider/pulsequorum/internal/version.Date=${DATE}" \
    -o /out/pulsequorum-probe ./cmd/pulsequorum-probe

# --- Runtime ----------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/pulsequorum-probe /pulsequorum-probe
# Empty data dir owned by nonroot, so a fresh named volume is writable. Distroless
# has no shell; its empty /home/nonroot serves as the source directory.
COPY --from=gcr.io/distroless/static-debian12:nonroot --chown=65532:65532 /home/nonroot /data
ENV DATA_DIR=/data
ENV NODE_ROLE=probe
EXPOSE 8080
USER nonroot:nonroot
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["/pulsequorum-probe", "healthcheck"]
ENTRYPOINT ["/pulsequorum-probe"]
