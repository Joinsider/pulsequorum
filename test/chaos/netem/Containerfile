# Network-fault sidecar for the chaos harness (test/chaos/harness). Each voter
# gets one sidecar that shares the voter's network namespace
# (--network container:<voter>) and runs iptables (partitions) and tc netem
# (latency, loss) against it. The image itself only sleeps.
#
# Build (the harness does this on demand):
#   podman build -t uc-chaos-netem:latest test/chaos/netem
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache iproute2 iptables
CMD ["sleep", "infinity"]
